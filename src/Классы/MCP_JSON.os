// Сериализация/десериализация JSON встроенными средствами OneScript (глобальные
// ЗаписатьJSON/ПрочитатьJSON поверх ЗаписьJSON/ЧтениеJSON), без внешней библиотеки
// json. Выделено отдельным классом, чтобы MCP_Сервер и MCP_Прогресс не дублировали
// логику. Экземпляр без состояния - обычно создаётся один на владельца (Новый MCP_JSON).

// Компактная (однострочная) сериализация значения в JSON. Однострочность обязательна:
// MCP stdio разделяет сообщения переводом строки, поэтому переводов внутри самого
// сообщения быть не должно (ПереносСтрокJSON.Нет).
Функция ВСтроку(Знач Значение) Экспорт

	Писатель = Новый ЗаписьJSON;
	Писатель.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Писатель, ПодготовитьЗначение(Значение));
	Возврат Писатель.Закрыть();

КонецФункции

// Разбор JSON-строки в Соответствие (вложенные объекты - тоже Соответствие).
Функция ВСоответствие(Знач Текст) Экспорт

	Читатель = Новый ЧтениеJSON;
	Читатель.УстановитьСтроку(Текст);
	Возврат ПрочитатьJSON(Читатель, Истина);

КонецФункции

// Рекурсивно готовит значение к встроенной сериализации: ЗаписатьJSON не умеет
// ТаблицаЗначений, поэтому приводим её к массиву структур-строк (как это делала
// прежняя библиотека json). Остальные коллекции обходим рекурсивно, примитивы
// возвращаем как есть.
Функция ПодготовитьЗначение(Знач Значение)

	Тип = ТипЗнч(Значение);

	Если Тип = Тип("ТаблицаЗначений") Тогда
		Результат = Новый Массив;
		Для Каждого СтрокаТаблицы Из Значение Цикл
			Запись = Новый Структура;
			Для Каждого Колонка Из Значение.Колонки Цикл
				Запись.Вставить(Колонка.Имя, ПодготовитьЗначение(СтрокаТаблицы[Колонка.Имя]));
			КонецЦикла;
			Результат.Добавить(Запись);
		КонецЦикла;
		Возврат Результат;

	ИначеЕсли Тип = Тип("Массив") ИЛИ Тип = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ПодготовитьЗначение(Элемент));
		КонецЦикла;
		Возврат Результат;

	ИначеЕсли Тип = Тип("Соответствие") ИЛИ Тип = Тип("ФиксированноеСоответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого КлючЗначение Из Значение Цикл
			Результат.Вставить(КлючЗначение.Ключ, ПодготовитьЗначение(КлючЗначение.Значение));
		КонецЦикла;
		Возврат Результат;

	ИначеЕсли Тип = Тип("Структура") ИЛИ Тип = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого КлючЗначение Из Значение Цикл
			Результат.Вставить(КлючЗначение.Ключ, ПодготовитьЗначение(КлючЗначение.Значение));
		КонецЦикла;
		Возврат Результат;

	Иначе
		Возврат Значение;
	КонецЕсли;

КонецФункции
