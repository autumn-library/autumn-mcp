// Репортёр прогресса MCP: шлёт notifications/progress в stdout по активному
// progressToken текущего вызова tools/call.
//
// MCP-клиент, передавший в запросе params._meta.progressToken, на каждое такое
// уведомление сбрасывает таймаут вызова - поэтому длительная синхронная команда
// не обрывается по таймауту. Сервер задаёт токен на время вызова (Начать/Завершить),
// а источник прогресса (сердцебиение наблюдателя длительной команды) раз в N секунд
// дёргает Сообщить(). Вне активного токена (клиент прогресс не запросил) Сообщить()
// молчит. Источник самопейсится (тик раз в интервал), поэтому троттлинг тут не нужен.
//
// Один экземпляр на процесс (&Желудь): сервер и наблюдатель получают его инъекцией/
// поиском по имени "MCP_Прогресс", поэтому токен у всех общий.

#Использовать json

Перем _ПарсерJSON;
Перем _Токен;     // progressToken текущего вызова (Неопределено - прогресс не запрошен)
Перем _Счётчик;   // монотонный progress

&Желудь
Процедура ПриСозданииОбъекта()
	_ПарсерJSON = Новый ПарсерJSON();
	_Токен = Неопределено;
	_Счётчик = 0;
КонецПроцедуры

// Начать репортинг для вызова с указанным progressToken.
// Токен = Неопределено - клиент прогресс не запрашивал (Сообщить() будет молчать).
Процедура Начать(Знач Токен) Экспорт
	_Токен = Токен;
	_Счётчик = 0;
КонецПроцедуры

// Завершить репортинг текущего вызова.
Процедура Завершить() Экспорт
	_Токен = Неопределено;
КонецПроцедуры

// Запрашивал ли клиент прогресс для текущего вызова.
Функция Активен() Экспорт
	Возврат _Токен <> Неопределено;
КонецФункции

// Отправить уведомление о прогрессе (если активен токен). progress монотонно
// растёт; Сообщение - необязательная человекочитаемая строка хода выполнения.
Процедура Сообщить(Знач Сообщение = "") Экспорт

	Если _Токен = Неопределено Тогда
		Возврат;
	КонецЕсли;

	_Счётчик = _Счётчик + 1;

	Параметры = Новый Соответствие();
	Параметры.Вставить("progressToken", _Токен);
	Параметры.Вставить("progress", _Счётчик);
	Если ЗначениеЗаполнено(Сообщение) Тогда
		Параметры.Вставить("message", Сообщение);
	КонецЕсли;

	Уведомление = Новый Соответствие();
	Уведомление.Вставить("jsonrpc", "2.0");
	Уведомление.Вставить("method", "notifications/progress");
	Уведомление.Вставить("params", Параметры);

	Консоль.ВывестиСтроку(_ПарсерJSON.ЗаписатьJSON(Уведомление, Ложь));

КонецПроцедуры
